# Maintainer: adelmonte
pkgname=arch-native-client
pkgver=1.2.0
pkgrel=1
pkgdesc="Client-side tools for arch-native: package list sync and forge upgrade helper"
arch=('any')
license=('GPL-3.0-or-later')
depends=('rsync' 'pacman' 'python')
install=arch-native-client.install

package() {
    # Manifest export script + hook (syncs package list to build server)
    install -Dm755 "$startdir/pkglist-export"   "$pkgdir/usr/bin/pkglist-export"
    install -Dm644 "$startdir/pkglist-export.hook" \
        "$pkgdir/usr/share/libalpm/hooks/pkglist-export.hook"

    # Repo upgrade script (run manually or from an update function after yay)
    install -Dm755 "$startdir/native-sync" "$pkgdir/usr/bin/native-sync"

    # Example config
    install -Dm644 "$startdir/arch-native-client.conf.example" \
        "$pkgdir/usr/share/arch-native-client/arch-native-client.conf.example"
}
