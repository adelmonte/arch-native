#!/bin/bash
# pkglist-export — Export installed package list and sync to arch-native build server.
#
# Reads connection settings from /etc/arch-native-client.conf.
# Copy /usr/share/arch-native-client/arch-native-client.conf.example to
# /etc/arch-native-client.conf and fill in your values before use.

set -euo pipefail

CONFIG_FILE="/etc/arch-native-client.conf"

if [[ ! -f "$CONFIG_FILE" ]]; then
    exit 0
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

: "${REMOTE_HOST:?REMOTE_HOST not set in $CONFIG_FILE}"
: "${REMOTE_PATH:?REMOTE_PATH not set in $CONFIG_FILE}"

EXPORT_FILE=$(mktemp /tmp/pkglist-export-XXXXXX.json)
trap 'rm -f "$EXPORT_FILE"' EXIT
SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=8)
if [[ -n "${SSH_KEY:-}" ]]; then
    SSH_OPTS+=(-i "$SSH_KEY")
fi

REMOTE="${REMOTE_HOST}:${REMOTE_PATH}"

# Build JSON manifest from pacman
pacman -Qi 2>/dev/null | python3 -c "
import sys, json, re, subprocess

# Get repo mapping from sync db
repo_map = {}
sl = subprocess.run(['pacman', '-Sl'], capture_output=True, text=True)
for line in sl.stdout.strip().split('\n'):
    parts = line.split()
    if len(parts) >= 2:
        repo_map[parts[1]] = parts[0]

# Parse -Qi for install info
text = sys.stdin.read()
packages = []
for block in text.strip().split('\n\n'):
    pkg = {}
    for line in block.split('\n'):
        m = re.match(r'^([\w ]+?)\s*:\s*(.+)', line)
        if m:
            pkg[m.group(1).strip()] = m.group(2).strip()
    if 'Name' in pkg:
        name = pkg['Name']
        packages.append({
            'name': name,
            'version': pkg.get('Version', ''),
            'repo': repo_map.get(name, 'unknown'),
            'reason': 'explicit' if 'Explicitly' in pkg.get('Install Reason', '') else 'dependency'
        })

print(json.dumps(packages, indent=2))
" > "$EXPORT_FILE"

PKG_COUNT=$(python3 -c "import json; print(len(json.load(open('$EXPORT_FILE'))))")

# pacman runs transaction hooks inside an isolated network namespace that has no
# tailscale0 interface, so a Tailscale-addressed build server is unroutable from
# here ("Network is unreachable"). Re-enter PID 1's network namespace (the host
# ns, which has tailscale0) for the sync. No-op when already in the host ns
# (e.g. run by hand); only attempted as root with nsenter available.
NSENTER=()
if [[ $EUID -eq 0 ]] && command -v nsenter >/dev/null 2>&1 \
    && [[ "$(readlink /proc/self/ns/net)" != "$(readlink /proc/1/ns/net)" ]]; then
    NSENTER=(nsenter --net=/proc/1/ns/net)
fi

# Best-effort sync: a failed sync must never fail the pacman transaction — the
# packages are already installed. Retry briefly to ride out any real network blip.
attempts=3
for ((i = 1; i <= attempts; i++)); do
    if "${NSENTER[@]}" rsync -az --checksum -e "ssh ${SSH_OPTS[*]}" "$EXPORT_FILE" "$REMOTE"; then
        logger -t pkglist-export "Synced $PKG_COUNT packages to $REMOTE_HOST"
        exit 0
    fi
    (( i < attempts )) && sleep 3
done

logger -t pkglist-export "WARNING: build server $REMOTE_HOST unreachable after $attempts attempts; skipped package-list sync"
echo "pkglist-export: build server unreachable, skipping sync (transaction unaffected)" >&2
exit 0
