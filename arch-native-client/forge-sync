#!/usr/bin/env bash
# forge-sync — Upgrade installed packages where forge has a newer build.
#
# Run manually or automatically via the forge-sync.hook PostTransaction hook.
# Set FORGE_REPO to override the repository name (default: forge).

set -euo pipefail

FORGE_REPO="${FORGE_REPO:-forge}"

# Build a map of forge package → version in one pass.
# Uses the cached DB — yay -Syu already synced it. For standalone runs,
# run 'pacman -Sy' first if you need fresh data.
declare -A forge_versions
while IFS=' ' read -r _ pkg ver _rest; do
    forge_versions["$pkg"]="$ver"
done < <(pacman -Sl "$FORGE_REPO" 2>/dev/null)

if [[ ${#forge_versions[@]} -eq 0 ]]; then
    printf '\033[1mforge-sync:\033[0m forge repo is empty or unreachable\n'
    exit 0
fi

# Find installed packages where forge has a strictly newer version.
installed_count=0
total_installed=0
upgrades=()
while IFS=' ' read -r pkg inst_ver; do
    (( ++total_installed ))
    forge_ver="${forge_versions[$pkg]:-}"
    [[ -z "$forge_ver" ]] && continue
    (( ++installed_count ))
    if (( $(vercmp "$forge_ver" "$inst_ver") > 0 )); then
        upgrades+=("${FORGE_REPO}/${pkg}")
    fi
done < <(pacman -Q 2>/dev/null)

printf '\033[1mforge-sync:\033[0m %d / %d  (%d%%)\n' "$installed_count" "$total_installed" "$(( installed_count * 100 / total_installed ))"

if [[ ${#upgrades[@]} -eq 0 ]]; then
    printf '\033[1mforge-sync:\033[0m nothing to upgrade\n'
    exit 0
fi

printf '\033[1mforge-sync:\033[0m upgrading %d package(s) from forge\n' "${#upgrades[@]}"
pacman -S --noconfirm --needed "${upgrades[@]}"
