#!/usr/bin/env bash
# native-sync — Upgrade installed packages where the forge repo has a newer build.
#
# Set FORGE_REPO to override the repository name (default: forge).

set -euo pipefail

FORGE_REPO="${FORGE_REPO:-forge}"
FORGE_PACKAGER_TAG="<buildbot@${FORGE_REPO}>"

# Show patch health published by the build server, if available.
# The daemon writes patch-status.json into the repo dir; the repo Server
# (nginx in remote mode, file:// in local mode) serves it alongside the
# package DB. Best-effort — silent if the server doesn't publish it (older
# server, or repo unreachable). Fetch + parse is done in one python call
# (already a dependency) so no extra tools are required.
print_patch_health() {
    local server counts total ok review fail orphaned
    server=$(pacman-conf --repo="$FORGE_REPO" Server 2>/dev/null | head -1) || return 0
    [[ -n "$server" ]] || return 0

    counts=$(python -c '
import json, sys, urllib.request
url = sys.argv[1].rstrip("/") + "/patch-status.json"
try:
    with urllib.request.urlopen(url, timeout=3) as r:
        d = json.load(r)
    print(d.get("total", 0), d.get("ok", 0), d.get("review", 0),
          d.get("fail", 0), d.get("orphaned", 0))
except Exception:
    print("0 0 0 0 0")
' "$server" 2>/dev/null) || return 0
    read -r total ok review fail orphaned <<<"$counts" || true

    (( ${total:-0} > 0 )) || return 0

    # Always show the health triad (ok/review/fail) including zeros so the
    # check is visibly accounted for. Append orphaned only when non-zero —
    # it's a cleanup note, not a health concern.
    local line="${ok:-0} ok, ${review:-0} review, ${fail:-0} fail"
    (( ${orphaned:-0} > 0 )) && line+=", ${orphaned} orphaned"
    printf '\033[1mnative-sync:\033[0m patches  %s\n' "$line"
}

# Build a map of forge package → version in one pass.
# Uses the cached DB — yay -Syu already synced it. For standalone runs,
# run 'pacman -Sy' first if you need fresh data.
declare -A forge_versions
while IFS=' ' read -r _ pkg ver _rest; do
    forge_versions["$pkg"]="$ver"
done < <(pacman -Sl "$FORGE_REPO" 2>/dev/null)

if [[ ${#forge_versions[@]} -eq 0 ]]; then
    printf '\033[1mnative-sync:\033[0m forge repo is empty or unreachable\n'
    exit 0
fi

# Collect installed packages that forge has a build for.
declare -A forge_installed  # pkg → inst_ver
total_installed=0
while IFS=' ' read -r pkg inst_ver; do
    (( ++total_installed ))
    [[ -n "${forge_versions[$pkg]:-}" ]] && forge_installed["$pkg"]="$inst_ver"
done < <(pacman -Q 2>/dev/null)

installed_count=${#forge_installed[@]}

printf '\033[1mnative-sync:\033[0m %d / %d  (%d%%)\n' \
    "$installed_count" "$total_installed" \
    "$(( installed_count * 100 / total_installed ))"

print_patch_health

if [[ "$installed_count" -eq 0 ]]; then
    printf '\033[1mnative-sync:\033[0m nothing to upgrade\n'
    exit 0
fi

# Build packager map from the local pacman DB (faster and more reliable than pacman -Qi).
declare -A packager_map
while IFS=$'\t' read -r pkg packager; do
    [[ -n "${forge_installed[$pkg]+_}" ]] && packager_map["$pkg"]="$packager"
done < <(awk \
    'FNR==1 { if (name && pkgr) printf "%s\t%s\n", name, pkgr; name=""; pkgr="" }
     /^%NAME%$/     { getline; name = $0 }
     /^%PACKAGER%$/ { getline; pkgr = $0 }
     END            { if (name && pkgr) printf "%s\t%s\n", name, pkgr }' \
    /var/lib/pacman/local/*/desc 2>/dev/null)

# Determine upgrades using version comparison and packager detection.
#
# forge > inst      → install (forge has a newer build)
# forge = inst, packager ≠ forge → install (upstream-installed, needs forge build)
# forge = inst, packager = forge → skip (already forge-installed)
# forge < inst      → skip (forge hasn't rebuilt yet)
upgrades=()
for pkg in "${!forge_installed[@]}"; do
    inst_ver="${forge_installed[$pkg]}"
    forge_ver="${forge_versions[$pkg]}"
    cmp=$(vercmp "$forge_ver" "$inst_ver")
    if (( cmp > 0 )); then
        upgrades+=("${FORGE_REPO}/${pkg}")
    elif (( cmp == 0 )); then
        packager="${packager_map[$pkg]:-}"
        inst_pkgrel="${inst_ver##*-}"
        # Skip if packager matches forge, or if the installed pkgrel has a dot
        # (dotted pkgrel = old forge build predating the PACKAGER field being set).
        if [[ "$packager" != *"$FORGE_PACKAGER_TAG"* && "$inst_pkgrel" != *.* ]]; then
            upgrades+=("${FORGE_REPO}/${pkg}")
        fi
    fi
done

if [[ ${#upgrades[@]} -eq 0 ]]; then
    printf '\033[1mnative-sync:\033[0m nothing to upgrade\n'
    exit 0
fi

printf '\033[1mnative-sync:\033[0m upgrading %d package(s) from forge\n' "${#upgrades[@]}"

# Clear cached packages before installing — a cached upstream build at the same
# version has a different checksum than the forge build, causing pacman to abort.
for pkg in "${upgrades[@]}"; do
    pkgname="${pkg#*/}"
    find /var/cache/pacman/pkg/ -maxdepth 1 -name "${pkgname}-*.pkg.tar.zst" -delete 2>/dev/null || true
done

pacman -S --noconfirm "${upgrades[@]}"
