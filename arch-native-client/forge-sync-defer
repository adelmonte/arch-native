#!/usr/bin/env bash
# forge-sync-defer — launch forge-sync after pacman releases its db lock.
#
# Called from the forge-sync PostTransaction hook. pacman holds the db lock
# for the duration of hook execution, so forge-sync (which calls pacman -S)
# cannot run inline. This script backgrounds a new-session child that waits
# for the lock to clear, then hands off to forge-sync.
#
# Uses setsid so the child survives hook process group teardown on non-systemd
# systems (Dinit, OpenRC, etc.) where systemd-run is unavailable.

setsid /bin/bash -c '
    lock=/var/lib/pacman/db.lck
    for _ in $(seq 30); do
        [[ ! -e "$lock" ]] && break
        sleep 1
    done
    /usr/bin/forge-sync
' &>/dev/null &
