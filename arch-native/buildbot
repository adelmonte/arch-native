#!/usr/bin/env python3
"""
buildbot — arch-native package build daemon.

Watches a client manifest (remote mode) or local pacman DB (local mode),
resolves PKGBUILDs, builds packages in a clean chroot with the configured
-march, signs them, and publishes to a pacman repo.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _here if os.path.isdir(os.path.join(_here, "arch_native")) else "/usr/lib/arch-native")

from arch_native.cli import main

if __name__ == "__main__":
    main()
